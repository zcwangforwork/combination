<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>贴敷式胰岛素泵 - 体系文档管理系统</title>
    <link rel="stylesheet" href="https://unpkg.com/element-plus/dist/index.css">
    <link rel="stylesheet" href="css/style.css">
</head>
<body>
    <div id="app">
        <!-- Login View -->
        <div v-if="!isLoggedIn" class="login-container">
            <div class="login-card">
                <div class="login-header">
                    <h1>贴敷式胰岛素泵</h1>
                    <p>体系文档管理系统</p>
                </div>
                <el-form ref="loginFormRef" :model="loginForm" :rules="loginRules" @keyup.enter="handleLogin">
                    <el-form-item prop="username">
                        <el-input v-model="loginForm.username" placeholder="用户名" size="large"
                            prefix-icon="User" clearable></el-input>
                    </el-form-item>
                    <el-form-item prop="password">
                        <el-input v-model="loginForm.password" type="password" placeholder="密码" size="large"
                            prefix-icon="Lock" show-password clearable></el-input>
                    </el-form-item>
                    <el-form-item>
                        <el-button type="primary" size="large" :loading="loginLoading"
                            style="width:100%" @click="handleLogin">
                            登 录
                        </el-button>
                    </el-form-item>
                </el-form>
                <div v-if="loginError" class="login-error">{{ loginError }}</div>
            </div>
        </div>

        <!-- Main Layout (after login) -->
        <div v-else class="main-layout">
            <!-- Sidebar -->
            <div class="sidebar">
                <div class="sidebar-header">
                    <h2>胰岛素泵</h2>
                    <p>体系文档管理系统</p>
                </div>
                <el-menu :default-active="activeMenu" @select="handleMenuSelect"
                    background-color="#304156" text-color="#bfcbd9" active-text-color="#409eff">
                    <el-menu-item index="dashboard">
                        <el-icon><DataAnalysis /></el-icon>
                        <span>工作台</span>
                    </el-menu-item>
                    <el-menu-item index="employees">
                        <el-icon><UserFilled /></el-icon>
                        <span>体系管理</span>
                    </el-menu-item>
                    <el-menu-item index="documents">
                        <el-icon><Document /></el-icon>
                        <span>体系文档</span>
                    </el-menu-item>
                    <el-menu-item v-if="currentRole === 'ADMIN'" index="departments">
                        <el-icon><OfficeBuilding /></el-icon>
                        <span>部门管理</span>
                    </el-menu-item>
                </el-menu>
            </div>

            <!-- Main Content -->
            <div class="main-content">
                <!-- Header -->
                <div class="topbar">
                    <div class="topbar-left">
                        <h3>{{ pageTitle }}</h3>
                    </div>
                    <div class="topbar-right">
                        <el-tag type="success" effect="dark">{{ currentRoleName }}</el-tag>
                        <span class="user-name">{{ currentUserName }}</span>
                        <el-button type="danger" text @click="handleLogout">退出登录</el-button>
                    </div>
                </div>

                <!-- Page Content -->
                <div class="page-content">
                    <!-- Dashboard -->
                    <div v-show="activeMenu === 'dashboard'">
                        <el-row :gutter="20">
                            <el-col :span="6" v-for="card in statCards" :key="card.label">
                                <el-card shadow="hover" class="stat-card" :body-style="{padding:'20px'}">
                                    <div class="stat-card-inner">
                                        <div class="stat-icon" :style="{backgroundColor: card.color}">
                                            <el-icon size="28" color="#fff"><component :is="card.icon" /></el-icon>
                                        </div>
                                        <div class="stat-info">
                                            <div class="stat-value">{{ card.value }}</div>
                                            <div class="stat-label">{{ card.label }}</div>
                                        </div>
                                    </div>
                                </el-card>
                            </el-col>
                        </el-row>

                        <el-row :gutter="20" style="margin-top:20px">
                            <el-col :span="12">
                                <el-card>
                                    <template #header><span>各角色体系分布</span></template>
                                    <div class="chart-container">
                                        <div v-for="(count, role) in dashboardStats.employeesByRole" :key="role"
                                            class="chart-bar-item">
                                            <span class="chart-label">{{ role }}</span>
                                            <el-progress :percentage="calcPercentage(count, dashboardStats.totalEmployees)"
                                                :color="getBarColor()" :stroke-width="18">
                                                <span class="chart-value">{{ count }}人</span>
                                            </el-progress>
                                        </div>
                                    </div>
                                </el-card>
                            </el-col>
                            <el-col :span="12">
                                <el-card>
                                    <template #header><span>各部门体系分布</span></template>
                                    <div class="chart-container">
                                        <div v-for="(count, dept) in dashboardStats.employeesByDepartment" :key="dept"
                                            class="chart-bar-item">
                                            <span class="chart-label">{{ dept }}</span>
                                            <el-progress :percentage="calcPercentage(count, dashboardStats.totalEmployees)"
                                                :color="getBarColor()" :stroke-width="18">
                                                <span class="chart-value">{{ count }}人</span>
                                            </el-progress>
                                        </div>
                                    </div>
                                </el-card>
                            </el-col>
                        </el-row>
                    </div>

                    <!-- Employee List -->
                    <div v-show="activeMenu === 'employees'">
                        <div class="toolbar">
                            <el-input v-model="searchKeyword" placeholder="搜索体系..." style="width:250px" clearable
                                @input="loadEmployees"></el-input>
                            <el-button type="primary" @click="showAddDialog" v-if="currentRole === 'ADMIN'">
                                <el-icon><Plus /></el-icon> 添加体系
                            </el-button>
                        </div>
                        <el-table :data="employeeList" border stripe v-loading="tableLoading" style="width:100%">
                            <el-table-column prop="id" label="ID" width="60"></el-table-column>
                            <el-table-column prop="employeeNo" label="工号" width="100"></el-table-column>
                            <el-table-column prop="realName" label="姓名" width="100"></el-table-column>
                            <el-table-column prop="username" label="用户名" width="120"></el-table-column>
                            <el-table-column prop="roleName" label="角色" width="120"></el-table-column>
                            <el-table-column prop="departmentName" label="部门" width="120"></el-table-column>
                            <el-table-column prop="email" label="邮箱" min-width="180"></el-table-column>
                            <el-table-column prop="phone" label="电话" width="130"></el-table-column>
                            <el-table-column label="状态" width="70">
                                <template #default="{row}">
                                    <el-tag :type="row.enabled ? 'success' : 'danger'" size="small">
                                        {{ row.enabled ? '在职' : '禁用' }}
                                    </el-tag>
                                </template>
                            </el-table-column>
                            <el-table-column prop="createTime" label="入职时间" width="170"></el-table-column>
                            <el-table-column label="操作" width="160" fixed="right"
                                v-if="currentRole === 'ADMIN'">
                                <template #default="{row}">
                                    <el-button type="primary" size="small" text @click="showEditDialog(row)">
                                        编辑</el-button>
                                    <el-popconfirm title="确定删除该体系？" @confirm="handleDelete(row.id)">
                                        <template #reference>
                                            <el-button type="danger" size="small" text>删除</el-button>
                                        </template>
                                    </el-popconfirm>
                                </template>
                            </el-table-column>
                        </el-table>
                        <div class="pagination-wrapper">
                            <el-pagination v-model:current-page="currentPage" :page-size="pageSize"
                                :total="totalEmployees" layout="total, prev, pager, next"
                                @current-change="loadEmployees" background></el-pagination>
                        </div>
                    </div>

                    <!-- Department View -->
                    <div v-show="activeMenu === 'departments'" v-if="currentRole === 'ADMIN'">
                        <el-button type="primary" @click="showDeptDialog = true">
                            <el-icon><Plus /></el-icon> 添加部门
                        </el-button>
                        <el-table :data="departments" border style="width:100%; margin-top:15px">
                            <el-table-column prop="id" label="ID" width="60"></el-table-column>
                            <el-table-column prop="name" label="部门名称" min-width="200"></el-table-column>
                            <el-table-column prop="description" label="描述" min-width="300"></el-table-column>
                            <el-table-column prop="createTime" label="创建时间" width="170"></el-table-column>
                        </el-table>
                    </div>

                    <!-- Document List -->
                    <div v-show="activeMenu === 'documents'">
                        <div class="toolbar">
                            <el-select v-model="docCategoryFilter" placeholder="按分类筛选" clearable
                                style="width:180px; margin-right:10px"
                                @change="docCurrentPage = 1; loadDocuments()">
                                <el-option v-for="c in categories" :key="c.id" :label="c.name" :value="c.id"></el-option>
                            </el-select>
                            <el-input v-model="docSearchKeyword" placeholder="搜索文档标题..." style="width:250px"
                                clearable @input="docCurrentPage = 1; loadDocuments()"></el-input>
                            <el-button type="primary" @click="showUploadDialog" v-if="canUploadDoc"
                                style="margin-left:10px">
                                <el-icon><Upload /></el-icon> 上传文档
                            </el-button>
                        </div>
                        <el-table :data="documentList" border stripe v-loading="docLoading" style="width:100%; margin-top:15px">
                            <el-table-column prop="id" label="ID" width="60"></el-table-column>
                            <el-table-column prop="title" label="标题" min-width="200" show-overflow-tooltip></el-table-column>
                            <el-table-column prop="categoryName" label="分类" width="120"></el-table-column>
                            <el-table-column prop="fileName" label="文件名" min-width="180" show-overflow-tooltip></el-table-column>
                            <el-table-column label="大小" width="100">
                                <template #default="{row}">{{ formatFileSize(row.fileSize) }}</template>
                            </el-table-column>
                            <el-table-column prop="fileExtension" label="类型" width="70"></el-table-column>
                            <el-table-column label="可见性" width="90">
                                <template #default="{row}">
                                    <el-tag :type="visibilityTagType(row.visibility)" size="small">
                                        {{ visibilityLabel(row.visibility) }}
                                    </el-tag>
                                </template>
                            </el-table-column>
                            <el-table-column label="版本" width="80">
                                <template #default="{row}">
                                    <span v-if="row.version">{{ row.version }}</span>
                                    <span v-else style="color:#909399">-</span>
                                </template>
                            </el-table-column>
                            <el-table-column label="状态" width="90">
                                <template #default="{row}">
                                    <el-tag :type="statusTagType(row.status)" size="small">
                                        {{ statusLabel(row.status) }}
                                    </el-tag>
                                </template>
                            </el-table-column>
                            <el-table-column prop="uploaderName" label="上传人" width="90"></el-table-column>
                            <el-table-column prop="createdAt" label="上传时间" width="170"></el-table-column>
                            <el-table-column label="操作" width="300" fixed="right">
                                <template #default="{row}">
                                    <el-button type="primary" size="small" text @click="handlePreview(row)">
                                        预览
                                    </el-button>
                                    <el-button type="success" size="small" text @click="handleDownload(row)">
                                        下载
                                    </el-button>
                                    <el-button v-if="canPublishDoc && (row.status === 'DRAFT' || row.status === 'PUBLISHED')"
                                        type="warning" size="small" text @click="showPublishDialog(row)">
                                        发布
                                    </el-button>
                                    <el-button type="info" size="small" text @click="loadRevisions(row)">
                                        修订
                                    </el-button>
                                    <el-popconfirm v-if="canDeleteDoc" title="确定删除该文档？" @confirm="handleDeleteDoc(row)">
                                        <template #reference>
                                            <el-button type="danger" size="small" text>删除</el-button>
                                        </template>
                                    </el-popconfirm>
                                </template>
                            </el-table-column>
                        </el-table>
                        <div class="pagination-wrapper">
                            <el-pagination v-model:current-page="docCurrentPage" :page-size="docPageSize"
                                :total="docTotal" layout="total, prev, pager, next"
                                @current-change="loadDocuments" background></el-pagination>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Employee Add/Edit Dialog -->
        <el-dialog v-model="dialogVisible" :title="dialogTitle" width="520px" @closed="resetForm">
            <el-form ref="empFormRef" :model="empForm" :rules="empRules" label-width="80px">
                <el-form-item label="用户名" prop="username">
                    <el-input v-model="empForm.username" :disabled="isEdit"></el-input>
                </el-form-item>
                <el-form-item label="姓名" prop="realName">
                    <el-input v-model="empForm.realName"></el-input>
                </el-form-item>
                <el-form-item label="密码" prop="password">
                    <el-input v-model="empForm.password" show-password
                        :placeholder="isEdit ? '留空则不修改密码' : '留空则默认为123456'"></el-input>
                </el-form-item>
                <el-form-item label="工号" prop="employeeNo">
                    <el-input v-model="empForm.employeeNo"></el-input>
                </el-form-item>
                <el-form-item label="角色" prop="roleCode">
                    <el-select v-model="empForm.roleCode" placeholder="选择角色" style="width:100%">
                        <el-option v-for="r in roles" :key="r.code" :label="r.name" :value="r.code"></el-option>
                    </el-select>
                </el-form-item>
                <el-form-item label="部门" prop="departmentName">
                    <el-select v-model="empForm.departmentName" placeholder="选择部门" style="width:100%"
                        filterable allow-create>
                        <el-option v-for="d in departments" :key="d.name" :label="d.name" :value="d.name"></el-option>
                    </el-select>
                </el-form-item>
                <el-form-item label="邮箱" prop="email">
                    <el-input v-model="empForm.email"></el-input>
                </el-form-item>
                <el-form-item label="电话" prop="phone">
                    <el-input v-model="empForm.phone"></el-input>
                </el-form-item>
                <el-form-item label="状态">
                    <el-switch v-model="empForm.enabled" active-text="启用" inactive-text="禁用"
                        :active-value="true" :inactive-value="false"></el-switch>
                </el-form-item>
            </el-form>
            <template #footer>
                <el-button @click="dialogVisible = false">取消</el-button>
                <el-button type="primary" :loading="submitLoading" @click="handleSubmit">确定</el-button>
            </template>
        </el-dialog>

        <!-- Department Add Dialog -->
        <el-dialog v-model="showDeptDialog" title="添加部门" width="400px">
            <el-form ref="deptFormRef" :model="deptForm" label-width="80px">
                <el-form-item label="部门名称" prop="name">
                    <el-input v-model="deptForm.name"></el-input>
                </el-form-item>
                <el-form-item label="描述">
                    <el-input v-model="deptForm.description" type="textarea"></el-input>
                </el-form-item>
            </el-form>
            <template #footer>
                <el-button @click="showDeptDialog = false">取消</el-button>
                <el-button type="primary" @click="handleAddDept">确定</el-button>
            </template>
        </el-dialog>

        <!-- Document Upload Dialog -->
        <el-dialog v-model="uploadDialogVisible" title="上传文档" width="520px" @closed="resetUploadForm">
            <el-form :model="uploadForm" label-width="80px">
                <el-form-item label="文件" required>
                    <el-upload
                        :auto-upload="false"
                        :limit="1"
                        :on-change="handleFileChange"
                        :on-exceed="() => ElementPlus.ElMessage.warning('只能上传一个文件')"
                        drag>
                        <el-icon class="el-icon--upload"><UploadFilled /></el-icon>
                        <div class="el-upload__text">拖拽文件到此处或<em>点击上传</em></div>
                        <template #tip>
                            <div class="el-upload__tip">
                                支持 PDF / 图片 / Word / Excel，单个文件不超过 50 MB
                            </div>
                        </template>
                    </el-upload>
                </el-form-item>
                <el-form-item label="标题" required>
                    <el-input v-model="uploadForm.title" placeholder="请输入文档标题"></el-input>
                </el-form-item>
                <el-form-item label="分类" required>
                    <el-select v-model="uploadForm.categoryId" placeholder="选择分类" style="width:100%">
                        <el-option v-for="c in categories" :key="c.id" :label="c.name" :value="c.id"></el-option>
                    </el-select>
                </el-form-item>
                <el-form-item label="可见性">
                    <el-select v-model="uploadForm.visibility" style="width:100%">
                        <el-option label="公开（全员可见）" value="PUBLIC"></el-option>
                        <el-option label="部门内可见" value="DEPARTMENT"></el-option>
                        <el-option label="指定人员（仅自己）" value="ASSIGNEES"></el-option>
                    </el-select>
                </el-form-item>
                <el-form-item label="描述">
                    <el-input v-model="uploadForm.description" type="textarea" :rows="3"
                        placeholder="可选，文档描述"></el-input>
                </el-form-item>
            </el-form>
            <template #footer>
                <el-button @click="uploadDialogVisible = false">取消</el-button>
                <el-button type="primary" :loading="uploadLoading" @click="handleUpload">上传</el-button>
            </template>
        </el-dialog>

        <!-- Document Preview Dialog -->
        <el-dialog v-model="previewDialogVisible" :title="previewTitle" width="80%"
            top="5vh" @close="closePreview" destroy-on-close>
            <div v-if="previewIsImage" style="text-align:center">
                <img :src="previewUrl" alt="预览" style="max-width:100%; max-height:75vh" />
            </div>
            <iframe v-else-if="previewIsPdf" :src="previewUrl"
                style="width:100%; height:75vh; border:none"></iframe>
            <div v-else style="text-align:center; padding:40px">
                <el-icon size="48" color="#909399"><Document /></el-icon>
                <p style="margin-top:15px">该文件类型不支持在线预览</p>
                <el-button type="primary" @click="handleDownload({id: null})">下载查看</el-button>
            </div>
        </el-dialog>

        <!-- Document Publish Dialog -->
        <el-dialog v-model="publishDialogVisible" title="发布文档" width="520px">
            <el-form label-width="100px" v-if="currentDocForPublish">
                <el-form-item label="文档标题">
                    <span>{{ currentDocForPublish.title }}</span>
                </el-form-item>
                <el-form-item label="当前版本">
                    <span>{{ currentDocForPublish.version || '-' }}
                        ({{ statusLabel(currentDocForPublish.status) }})</span>
                </el-form-item>
                <el-form-item label="变更说明">
                    <el-input v-model="publishForm.changeLog" type="textarea" :rows="4"
                        placeholder="可选，本次发布的变更说明，将记录在修订历史中"></el-input>
                </el-form-item>
                <el-alert v-if="currentDocForPublish && currentDocForPublish.status === 'PUBLISHED'"
                    title="该文档已发布，本次发布将创建新版本（v1.x 自增）"
                    type="info" :closable="false" show-icon style="margin-top:10px">
                </el-alert>
                <el-alert v-else-if="currentDocForPublish && currentDocForPublish.status === 'DRAFT'"
                    title="该文档为草稿，首次发布后将变为已发布状态"
                    type="success" :closable="false" show-icon style="margin-top:10px">
                </el-alert>
            </el-form>
            <template #footer>
                <el-button @click="publishDialogVisible = false">取消</el-button>
                <el-button type="primary" :loading="publishLoading" @click="submitPublish">
                    确认发布
                </el-button>
            </template>
        </el-dialog>

        <!-- Document Revision History Dialog -->
        <el-dialog v-model="revisionDialogVisible" title="修订历史" width="900px" top="5vh">
            <div v-if="currentDocForRevision" style="margin-bottom:15px">
                <strong>{{ currentDocForRevision.title }}</strong>
                <span style="color:#909399; margin-left:10px">
                    当前版本: {{ currentDocForRevision.version || '-' }}
                </span>
            </div>
            <el-table :data="revisionList" border stripe v-loading="revisionLoading"
                style="width:100%" empty-text="暂无修订历史">
                <el-table-column prop="version" label="版本" width="80"></el-table-column>
                <el-table-column prop="title" label="标题" min-width="180" show-overflow-tooltip></el-table-column>
                <el-table-column prop="changeLog" label="变更说明" min-width="200" show-overflow-tooltip>
                    <template #default="{row}">
                        <span v-if="row.changeLog">{{ row.changeLog }}</span>
                        <span v-else style="color:#909399">-</span>
                    </template>
                </el-table-column>
                <el-table-column prop="publishedByName" label="发布人" width="100"></el-table-column>
                <el-table-column prop="publishedAt" label="发布时间" width="170"></el-table-column>
                <el-table-column label="操作" width="200" fixed="right">
                    <template #default="{row}">
                        <el-button type="success" size="small" text @click="handleDownloadRevision(row)">
                            下载
                        </el-button>
                        <el-popconfirm v-if="canRollbackDoc"
                            :title="`确定回滚到版本 ${row.version}？将创建新版本，原版本保留。`"
                            @confirm="handleRollback(row)">
                            <template #reference>
                                <el-button type="warning" size="small" text>回滚</el-button>
                            </template>
                        </el-popconfirm>
                    </template>
                </el-table-column>
            </el-table>
            <template #footer>
                <el-button @click="revisionDialogVisible = false">关闭</el-button>
            </template>
        </el-dialog>
    </div>

    <!-- Vue 3 + Element Plus CDN -->
    <script src="https://unpkg.com/vue@3/dist/vue.global.prod.js"></script>
    <script src="https://unpkg.com/element-plus"></script>
    <script src="https://unpkg.com/@element-plus/icons-vue"></script>
    <script src="https://unpkg.com/axios/dist/axios.min.js"></script>
    <script src="js/app.js"></script>
</body>
</html>
