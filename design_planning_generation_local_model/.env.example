# .env.example — 环境变量模板（真实 .env 已被 .gitignore 排除，含 API 密钥勿入库）
# 复制为 .env 后填入实际值：cp .env.example .env

# ── Ollama 本地模型 ──
OLLAMA_BASE_URL=http://localhost:11435
OLLAMA_MODEL=qwen3.5:122b
OLLAMA_EMBED_MODEL=

# ── MiniMax API（文档生成的云端 LLM 备选路径）──
MINIMAX_API_KEY=<your-minimax-api-key>

# ── Claude Agent SDK 配置（Agent 模式使用）──
ANTHROPIC_API_KEY=<your-anthropic-api-key>
# git-bash 路径（Windows 必需）
CLAUDE_CODE_GIT_BASH_PATH=
# 代理配置（可选，如主机已配置全局代理则无需设置）
CLAUDE_HTTP_PROXY=
CLAUDE_HTTPS_PROXY=

# ── MinerU 本地解析模型 ──
# 启用 MinerU 本地模型解析路径（true 时优先使用 MinerU，失败回退本地解析器）
USE_MINERU=false
# 本地模型目录路径（MinerU2.5-Pro-2605-1.2B）
MINERU_LOCAL_MODEL_PATH=
# 单文件解析超时秒数（默认 1200）
MINERU_TIMEOUT=1200

# ── OpenViking 长期记忆 ──
OPENVIKING_URL=
OPENVIKING_API_KEY=<your-openviking-api-key>
OPENVIKING_ACCOUNT=
OPENVIKING_USER=
OPENVIKING_ACTOR_PEER_ID=
OPENVIKING_ENABLED=false

# ── 长期记忆存储 ──
LONG_TERM_MEMORY_ENABLED=false
LONG_TERM_MEMORY_DB_URI=
LONG_TERM_MEMORY_EMBED_DIMS=

# ── 千问AI平台 MCP（联网搜索增强版 EnhancedSearch 等 One Key MCP 服务）──
# 平台 API Key（sk-xxx），获取：platform.qianwenai.com / 阿里云百炼控制台
# 未配置时 MCP 服务器 qianwen_enhanced_search 加载会被跳过并提示
DASHSCOPE_API_KEY=

# ── GitHub 官方远程 MCP Server（api.githubcopilot.com/mcp/ 托管）──
# PAT 获取：GitHub → Settings → Developer settings → Personal access tokens
# 只读公共仓库可不勾 scope；私有仓库需 repo（Classic）或对应仓库 Contents/Issues 只读权限（Fine-grained）
# 未配置时 MCP 服务器 github 加载会被跳过并提示
GITHUB_PERSONAL_ACCESS_TOKEN=

# ── 保密数据权限受控 RAG（2026-09-28，详见 docs 方案 §14.1）──
# 过滤模式三态：off=上线前行为（紧急回滚）/ shadow=只审计不过滤（灰度默认）/ enforce=过滤+拦截生效
SEC_FILTER_MODE=shadow
# 未标注 chunk 的等效密级（脚本批量入库缺省；倒逼精标，fail-closed 起步）
SEC_DEFAULT_LEVEL=3
# 页面上传默认密级策略：uploader=上传者密级 / max=一律按最高
SEC_UPLOAD_DEFAULT=uploader
# 检索超额召回倍数（n_results 封顶 50）
SEC_OVERFETCH=3
# L3 输出泄漏检测：词级 n-gram 长度与重叠率拦截阈值
SEC_LEAK_NGRAM=8
SEC_LEAK_THRESHOLD=0.15
# 用户密级查库缓存 TTL（秒）；密级变更后最长经此窗口收敛
SEC_USER_CACHE_TTL=300
# 审计保留天数（SQLite 审计表随写入顺带清理）
SEC_AUDIT_RETENTION=365
